# ============================================================
# MiMo V2.5-TTS 三合一测试台 · 环境配置示例
# 使用方法：复制本文件为 .env（同目录），填入你的 Key 后重启 node server.js
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# ============================================================

# 必填：你的 MiMo API Key（仅保存在服务端，不会下发到浏览器）
MIMO_API_KEY=你的Key

# API 基址：
#   官方默认：      https://api.xiaomimimo.com/v1
#   Token Plan 国内集群：https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1

# 本地服务监听配置
PORT=8787
HOST=127.0.0.1
